# Dependencies (Vercel runs `npm install` itself — never upload these)
node_modules/

# Build output (Vercel rebuilds it — stale copies only cause confusion)
dist/
dist-ssr/

# Local environment files (secrets must never reach git/vercel)
.env
.env.*
!.env.example

# Logs
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*
lerna-debug.log*

# Editor / OS junk
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
Thumbs.db

# Vercel / deployment internals
.vercel

# TypeScript build info (if you ever add TS)
*.tsbuildinfo